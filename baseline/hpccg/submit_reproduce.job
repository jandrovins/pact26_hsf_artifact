#!/usr/bin/env bash
# =============================================================================
# submit_reproduce.job — SLURM batch script for baseline HPCCG (MPI+OpenMP)
# Arguments: <binary> <NX> <NY> <NZLOCAL> <MAXIT> <PPN> <CPUS> <NUMA>
# =============================================================================

bin=$1
NX=$2
NY=$3
NZLOCAL=$4
MAXIT=$5
PPN=$6
CPUS=$7
NUMA=$8

BASE_ROOT="/nfs/home/Computational/varcila/pact_consolidated/baseline"
BENCH_DIR="$BASE_ROOT/hpccg"

echo "=== HPCCG baseline: nx=$NX ny=$NY nzlocal=$NZLOCAL maxit=$MAXIT ppn=$PPN cpus=$CPUS numa=$NUMA ==="

echo "[TIMING] before nix develop: $(date +%T.%N)"
nix develop --impure "$BASE_ROOT" --command bash -c "
    set -e
    echo \"[TIMING] inside nix shell: \$(date +%T.%N)\"
    cd '$BENCH_DIR'
    if [ ! -f '$bin' ]; then
        echo 'Building $bin...'
        make '$bin'
    fi
    echo \"[TIMING] after build check: \$(date +%T.%N)\"
    ulimit -c unlimited
    export VVV_NUMA_INTERLEAVED=$NUMA
    export OMP_PROC_BIND=true
    export OMP_NUM_THREADS=$CPUS
    srun -v --hint=nomultithread \
        --exclusive \
        --cpu-bind=verbose \
        -N \$SLURM_JOB_NUM_NODES \
        --ntasks-per-node=$PPN \
        --cpus-per-task=$CPUS \
        '$BENCH_DIR/$bin' $NX $NY $NZLOCAL $MAXIT
    echo \"[TIMING] after srun: \$(date +%T.%N)\"
"
echo "[TIMING] after nix develop exit: $(date +%T.%N)"
