#!/usr/bin/env bash
# ============================================================================
# submit_heat.job — Submit script for heat-tg2 benchmark
#
# Arguments: <binary> <N> <BS> <ITS> <WARMUP> <CPUS> <REPS_PER_SBATCH> [ovni]
# ============================================================================

echo "Starting in pwd $(pwd)"

HOSTNAME=$(hostname)
BASE_ROOT="/nfs/home/Computational/varcila/ics_nosvorig"

HEAT_TG2="$BASE_ROOT/heat"

bin=$1
N=$2
BS=$3
ITS=$4
WARMUP=$5
CPUS=$6
reps_per_sbatch=$7
ovni=${8:-none}

timestamp=$(date +%s)
export OVNI_TRACEDIR=ovni_${VVV_EXP_STR}_$timestamp

export NOSV_CONFIG_OVERRIDE=${NOSV_CONFIG_OVERRIDE},instrumentation.version=$ovni
export NOSV_CONFIG=${NOSV_CONFIG:-nosv.toml}
echo "cpus=$CPUS N=$N BS=$BS ITS=$ITS WARMUP=$WARMUP"
echo "reps_per_sbatch=$reps_per_sbatch"

# Warmup flag: -W disables warmup (WARMUP=0 → pass -W)
WARMUP_FLAG=""
if [ "$WARMUP" = "0" ]; then
    WARMUP_FLAG="-W"
fi

# Build and run inside nix devshell so library paths (nosv, tglib, nodes) are correct.
echo "Running inside nix devshell..."
nix develop --impure "$BASE_ROOT" --command bash -c "
    set -e
    cd '$HEAT_TG2'
    if [ ! -f '$bin' ]; then
        echo 'Binary not found, building $bin...'
        make '$bin'
        echo 'Build complete.'
    else
        echo 'Binary exists, skipping build.'
    fi
    ls -la '$bin'
    ulimit -c unlimited
    for ((rep=1; rep<=$reps_per_sbatch; rep++)); do
        echo \"=== REP \${rep} ===\"
        set -x
        srun -v --hint=nomultithread \
            --exclusive \
            --cpu-bind=verbose \
            -N $SLURM_JOB_NUM_NODES \
            --ntasks-per-node=1 \
            --cpus-per-task=$CPUS \
            '$HEAT_TG2/$bin' -r $N -c $N -t $ITS -b $BS $WARMUP_FLAG
        set +x
    done
"

end_timestamp=$(date +%s)
elapsed=$((end_timestamp - timestamp))
echo "Elapsed time: ${elapsed} seconds"

if [ "$ovni" == "ovni" ]; then
    ovniemu -b $OVNI_TRACEDIR
fi
