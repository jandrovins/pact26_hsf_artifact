#!/usr/bin/env bash
# =============================================================================
# submit_reproduce.job — SLURM batch script for nosvorig Cholesky
# Arguments: <binary> <nsize> <ts>
# =============================================================================

bin=$1
nsize=$2
ts=$3
params="$nsize $ts 1"

BASE_ROOT="${REPRO_BASE_ROOT:?REPRO_BASE_ROOT not set; submit via launcher_reproduce.sh}"
BENCH_DIR="$BASE_ROOT/cholesky"

export NOSV_CONFIG_OVERRIDE="${NOSV_CONFIG_OVERRIDE},instrumentation.version=none"

echo "=== Cholesky nosvorig: N=$nsize TS=$ts ==="
echo "NOSV_CONFIG_OVERRIDE=$NOSV_CONFIG_OVERRIDE"

echo "[TIMING] before nix develop: $(date +%T.%N)"
nix develop --impure "$BASE_ROOT" --command bash -c "
    set -e
    echo \"[TIMING] inside nix shell: \$(date +%T.%N)\"
    cd '$BENCH_DIR'
    if [ ! -f '$bin' ]; then
        echo 'Building $bin...'
        make '$bin'
    fi
    echo \"[TIMING] after build check: \$(date +%T.%N)\"
    ulimit -c unlimited
    srun -v --hint=nomultithread \
        --exclusive \
        --cpu-bind=verbose,none \
        -N \$SLURM_JOB_NUM_NODES \
        --ntasks-per-node=1 \
        --cpus-per-task=\$SLURM_CPUS_PER_TASK \
        ./$bin $params
    echo \"[TIMING] after srun: \$(date +%T.%N)\"
"
echo "[TIMING] after nix develop exit: $(date +%T.%N)"
