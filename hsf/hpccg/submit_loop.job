#!/usr/bin/env bash
# ============================================================================
# submit_loop.job — Submit script with inner repetition loop
#
# Arguments: <binary> <nx> <ny> <nz> <max_iter> <ntasks> <imm> <reps_per_sbatch> [ovni]
# ============================================================================

echo "Starting in pwd $(pwd)"

HOSTNAME=$(hostname)
BASE_ROOT="/nfs/home/Computational/varcila/ics_amdblis"
if echo "$HOSTNAME" | grep -q "owl"; then
    BASE_ROOT="/home/Computational/varcila/ics_amdblis"
fi

HPCCG2="$BASE_ROOT/hpccg2"

bin=$1
nx=$2
ny=$3
nz=$4
max_iter=$5
ntasks=$6
imm=$7
reps_per_sbatch=$8
ovni=${9:-none}

params="$nx $ny $nz $max_iter $ntasks"

timestamp=$(date +%s)
export OVNI_TRACEDIR=ovni_${VVV_EXP_STR}_$timestamp

export NOSV_CONFIG_OVERRIDE=${NOSV_CONFIG_OVERRIDE},instrumentation.version=$ovni
export NOSV_CONFIG_OVERRIDE=${NOSV_CONFIG_OVERRIDE},scheduler.immediate_successor=$imm
export NOSV_CONFIG=${NOSV_CONFIG:-nosv.toml}

echo "VVV_TG_ENABLED=$VVV_TG_ENABLED"
echo "VVV_LOWER_LVL=$VVV_LOWER_LVL"
echo "VVV_UPPER_LVL=$VVV_UPPER_LVL"
echo "VVV_AFF_FLEXIBLE=$VVV_AFF_FLEXIBLE"
echo "VVV_SPMV_TG_ENABLED=${VVV_SPMV_TG_ENABLED:-0}"
echo "VVV_SPMV_POLICY=${VVV_SPMV_POLICY:-NONE}"
echo "VVV_SPMV_IMM=${VVV_SPMV_IMM:-0}"
echo "VVV_BS_FACTOR=${VVV_BS_FACTOR:-4}"
echo "VVV_SPMV_TG_MULT=${VVV_SPMV_TG_MULT:-1}"

echo "ppn=$SLURM_NTASKS_PER_NODE nprocs=$SLURM_NPROCS cpus_per_task=$SRUN_CPUS_PER_TASK"
echo "params=$params"
echo "reps_per_sbatch=$reps_per_sbatch"

# Build and run inside nix devshell so library paths (nosv, tglib, nodes) are correct.
# Build is skipped if binary already exists. Inner loop runs reps_per_sbatch repetitions.
echo "Running inside nix devshell..."
nix develop --impure "$BASE_ROOT" --command bash -c "
    set -e
    cd '$HPCCG2'
    mkdir -p out obj
    if [ ! -f '$bin' ]; then
        echo 'Binary not found, building...'
        make -B HPCCG_mpi_oss-notampi.bin MPIMCXX=mpicxx \
            CXXFLAGS='-D_GNU_SOURCE -Iinclude -DWALL -O3 -g -ffast-math -march=native -fno-omit-frame-pointer' \
            SYS_LIB=\"-lm -lnuma -L\${TGLIB_HOME}/lib -ltglib\"
        echo 'Build complete.'
    else
        echo 'Binary exists, skipping build.'
    fi
    ls -la '$bin'
    ulimit -c unlimited
    for ((rep=1; rep<=$reps_per_sbatch; rep++)); do
        echo \"=== REP \${rep} ===\"
        set -x
        srun -v --hint=nomultithread \
            --exclusive \
            --cpu-bind=verbose \
            -N $SLURM_JOB_NUM_NODES \
            --ntasks-per-node=$SLURM_NTASKS_PER_NODE \
            --cpus-per-task=$SRUN_CPUS_PER_TASK \
            '$HPCCG2/$bin' t1 $params
        set +x
    done
"

end_timestamp=$(date +%s)
elapsed=$((end_timestamp - timestamp))
echo "Elapsed time: ${elapsed} seconds"

if [ "$ovni" == "ovni" ]; then
    ovniemu -b $OVNI_TRACEDIR
fi
