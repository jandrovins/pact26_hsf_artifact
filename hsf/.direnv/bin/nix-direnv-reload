#!/usr/bin/env bash
set -e
if [[ ! -d "/nfs/home/Computational/varcila/pact_consolidated/hsf" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/nfs/home/Computational/varcila/pact_consolidated/hsf")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/nfs/home/Computational/varcila/pact_consolidated/hsf" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/nfs/home/Computational/varcila/pact_consolidated/hsf/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/nfs/home/Computational/varcila/pact_consolidated/hsf/.envrc" "/nfs/home/Computational/varcila/pact_consolidated/hsf/.direnv"/*.rc
