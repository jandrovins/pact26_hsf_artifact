#!/usr/bin/env bash

# ============================================================================
# submit-insalloc-new.job — Multisaxpy inner-loop submit script
# ============================================================================
# Called by launcher_new.sh via sbatch (single job per experiment).
# Enters the nix devshell once, builds if needed, then runs reps_per_sbatch
# repetitions in a tight srun loop.
#
# Arguments: <binary> <N> <TS> <ITERATIONS> <reps_per_sbatch> [ovni]
# ============================================================================

echo "Starting in pwd $(pwd)"

HOSTNAME=$(hostname)
BASE_ROOT="/nfs/home/Computational/varcila/ics_amdblis"
if echo "$HOSTNAME" | grep -q "owl"; then
    BASE_ROOT="/home/Computational/varcila/ics_amdblis"
fi

WORKDIR="$BASE_ROOT/multisaxpy-nosv-orig"

bin=$1
nsize=$2
ts=$3
its=$4
reps_per_sbatch=$5
ovni=${6:-none}

params="$nsize $ts $its"

timestamp=$(date +%s)
export OVNI_TRACEDIR=ovni_${VVV_EXP_STR}_$timestamp

export NOSV_CONFIG_OVERRIDE=${NOSV_CONFIG_OVERRIDE},instrumentation.version=$ovni
export NOSV_CONFIG_OVERRIDE=${NOSV_CONFIG_OVERRIDE},scheduler.immediate_successor=false
export NOSV_CONFIG=${NOSV_CONFIG:-nosv.toml}

echo "VVV_TG_ENABLED=$VVV_TG_ENABLED"
echo "VVV_LOWER_LVL=$VVV_LOWER_LVL"
echo "VVV_UPPER_LVL=$VVV_UPPER_LVL"
echo "VVV_AFF_FLEXIBLE=$VVV_AFF_FLEXIBLE"
echo "VVV_TG_POLICY=$VVV_TG_POLICY"
echo "ppn=$SLURM_NTASKS_PER_NODE nprocs=$SLURM_NPROCS cpus_per_task=$SRUN_CPUS_PER_TASK"
echo "params=$params"
echo "reps_per_sbatch=$reps_per_sbatch"

ulimit -c unlimited

# Export variables needed by the inner script so it can pick them up from env.
export INNER_WORKDIR="$WORKDIR"
export INNER_BIN="$bin"
export INNER_PARAMS="$params"
export INNER_REPS="$reps_per_sbatch"

# Write inner script to a temp file — avoids all bash -c quoting issues.
INNER_SCRIPT=$(mktemp /tmp/nosv_inner_XXXXXX.sh)
cat > "$INNER_SCRIPT" << 'EOINNER'
#!/usr/bin/env bash
set -e
cd "$INNER_WORKDIR"
if [ ! -f "$INNER_BIN" ]; then
    echo 'Binary not found, building...'
    make -B
    echo 'Build complete.'
else
    echo 'Binary exists, skipping build.'
fi
ls -la "$INNER_BIN"
ulimit -c unlimited
for ((rep=1; rep<=INNER_REPS; rep++)); do
    echo "=== REP ${rep} ==="
    set -x
    srun -v --hint=nomultithread \
        --exclusive \
        --cpu-bind=verbose \
        -N "$SLURM_JOB_NUM_NODES" \
        --ntasks-per-node="$SLURM_NTASKS_PER_NODE" \
        --cpus-per-task="$SRUN_CPUS_PER_TASK" \
        "./$INNER_BIN" $INNER_PARAMS
    set +x
done
EOINNER

# Substitute the literal INNER_REPS placeholder with the actual numeric value.
sed -i "s/INNER_REPS/$INNER_REPS/g" "$INNER_SCRIPT"
chmod +x "$INNER_SCRIPT"

# Enter nix devshell once and run the temp script.
nix develop --impure "$BASE_ROOT" --command bash "$INNER_SCRIPT"
rm -f "$INNER_SCRIPT"

end_timestamp=$(date +%s)
elapsed=$((end_timestamp - timestamp))
echo "Elapsed time: ${elapsed} seconds"

if [ "$ovni" == "ovni" ]; then
    ovniemu -b $OVNI_TRACEDIR
fi
