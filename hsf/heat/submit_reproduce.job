#!/usr/bin/env bash
# =============================================================================
# submit_reproduce.job — SLURM batch script for HSF Heat
# Arguments: <binary> <N> <BS> <ITS> <WARMUP> <CPUS>
# =============================================================================

bin=$1
N=$2
BS=$3
ITS=$4
WARMUP=$5
CPUS=$6

BASE_ROOT="${REPRO_BASE_ROOT:?REPRO_BASE_ROOT not set; submit via launcher_reproduce.sh}"
BENCH_DIR="$BASE_ROOT/heat"

WARMUP_FLAG=""
if [ "$WARMUP" = "0" ]; then
    WARMUP_FLAG="-W"
fi

export NOSV_CONFIG_OVERRIDE="${NOSV_CONFIG_OVERRIDE},instrumentation.version=none"

echo "=== Heat HSF: N=$N BS=$BS ITS=$ITS ==="
echo "VVV_TG_ENABLED=$VVV_TG_ENABLED VVV_LOWER_LVL=$VVV_LOWER_LVL VVV_UPPER_LVL=$VVV_UPPER_LVL"

echo "[TIMING] before nix develop: $(date +%T.%N)"
nix develop --impure "$BASE_ROOT" --command bash -c "
    set -e
    echo \"[TIMING] inside nix shell: \$(date +%T.%N)\"
    cd '$BENCH_DIR'
    if [ ! -f '$bin' ]; then
        echo 'Building $bin...'
        make -B '$bin'
    fi
    echo \"[TIMING] after build check: \$(date +%T.%N)\"
    ulimit -c unlimited
    srun -v --hint=nomultithread \
        --exclusive \
        --cpu-bind=verbose \
        -N \$SLURM_JOB_NUM_NODES \
        --ntasks-per-node=1 \
        --cpus-per-task=$CPUS \
        '$BENCH_DIR/$bin' -r $N -c $N -t $ITS -b $BS $WARMUP_FLAG
    echo \"[TIMING] after srun: \$(date +%T.%N)\"
"
echo "[TIMING] after nix develop exit: $(date +%T.%N)"
